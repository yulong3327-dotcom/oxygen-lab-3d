{
  "schemaVersion": 1,
  "id": "current-voltage",
  "title": "探究电流与电压的关系",
  "summary": "保持定值电阻不变，移动滑动变阻器的滑片，测量定值电阻两端的电压和流过它的电流。",
  "note": "仿真采用 6 V 理想直流电源、10 Ω 定值电阻和 0–50 Ω 滑动变阻器。忽略导线、电表和电源内阻的非理想影响。",
  "conclusion": "电阻一定时，通过导体的电流与它两端的电压成正比。观察 I–U 图，并比较各组的 U/I。",
  "view": { "theta": 0.12, "phi": 0.59, "zoom": 0.80 },
  "instruments": [
    { "id": "power", "assetId": "dc-power-supply", "assetVersion": 1, "label": "直流电源", "position": [-0.25, 0, -0.215] },
    { "id": "switch", "assetId": "knife-switch", "assetVersion": 1, "label": "开关", "position": [0.245, 0, -0.22] },
    { "id": "ammeter", "assetId": "analog-ammeter", "assetVersion": 2, "label": "电流表", "position": [0.25, 0, 0.125] },
    { "id": "resistor", "assetId": "fixed-resistor", "assetVersion": 1, "label": "定值电阻", "position": [0, 0, 0.125] },
    { "id": "voltmeter", "assetId": "analog-voltmeter", "assetVersion": 2, "label": "电压表", "position": [0, 0, -0.075] },
    { "id": "rheostat", "assetId": "sliding-rheostat", "assetVersion": 1, "label": "滑动变阻器", "position": [-0.25, 0, 0.125] }
  ],
  "assembly": [
    { "instrumentId": "power", "area": [0.033, 0.027], "hint": "把直流电源放在台面左后方。" },
    { "instrumentId": "switch", "area": [0.033, 0.027], "hint": "把开关放在台面右后方。接线时保持断开。" },
    { "instrumentId": "ammeter", "area": [0.033, 0.027], "hint": "把电流表放在台面右前方。" },
    { "instrumentId": "resistor", "area": [0.033, 0.027], "hint": "把 10 Ω 定值电阻放在台面前方中央。" },
    { "instrumentId": "voltmeter", "area": [0.033, 0.027], "hint": "把电压表放在定值电阻的后方。" },
    { "instrumentId": "rheostat", "area": [0.033, 0.027], "hint": "把滑动变阻器放在台面左前方。" }
  ],
  "steps": [
    {
      "id": "wire", "title": "连接电路",
      "instruction": "开关断开。把电流表、定值电阻、滑动变阻器和开关串联到电源；电压表并联在定值电阻两端。变阻器接一上一下。",
      "observable": "主回路和测量支路接线正确。",
      "wrongFeedback": "检查主回路、两表的接线与滑动变阻器的接线柱。",
      "action": { "type": "circuit-wire" }
    },
    {
      "id": "prepare", "title": "把变阻器调到最大",
      "instruction": "把滑片移到离已接下接线柱最远的一端，让接入电路的电阻最大。",
      "observable": "滑动变阻器接入最大阻值 50 Ω。",
      "wrongFeedback": "请把滑片移到离已接下接线柱最远的一端。",
      "action": { "type": "circuit-prepare" }
    },
    {
      "id": "close", "title": "闭合开关",
      "instruction": "闭合开关，观察两块表的指针。",
      "observable": "电流表和电压表指针偏转。",
      "wrongFeedback": "确认变阻器接入阻值最大后再闭合开关。",
      "action": { "type": "circuit-close" }
    },
    {
      "id": "measure", "title": "测量三组 U、I",
      "instruction": "读两表并记录一组数据。移动滑片改变电压，共记录三组不同的 U、I。定值电阻保持 10 Ω。",
      "observable": "三组测量点已画在 I–U 图上。",
      "wrongFeedback": "请移动滑片，使这次电压和已记录的数据有明显差别。",
      "action": { "type": "circuit-measure" }
    },
    {
      "id": "open", "title": "断开开关",
      "instruction": "测量结束，断开开关。比较各组 U/I，并观察 I–U 图。",
      "observable": "两块表归零；数据和图像保留，供比较。",
      "wrongFeedback": "请断开开关，结束测量。",
      "action": { "type": "circuit-open" }
    }
  ],
